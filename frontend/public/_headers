# Penetapan cache untuk aset statik SPeRK (Workers static assets).
# Fail berhash (dalam /assets) boleh dicache lama kerana nama berubah setiap build.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/logo.svg
  Cache-Control: public, max-age=604800

/logo-web.svg
  Cache-Control: public, max-age=604800

/logo-nav.svg
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/index.html
  Cache-Control: public, max-age=0, must-revalidate

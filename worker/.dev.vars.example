# Salin fail ini kepada .dev.vars dan isi nilai sebenar.
# .dev.vars TIDAK boleh dicommit (lihat .gitignore).

# Senarai e-mel yang dibenarkan, dipisahkan dengan koma.
# Jika kosong, semua akaun ditolak.
ALLOWED_EMAILS=contoh@sekolah.edu.my

# Kandungan penuh fail akaun perkhidmatan Firebase (JSON dalam satu baris).
# Firebase Console > Project settings > Service accounts > Generate new private key.
FIREBASE_SERVICE_ACCOUNT=
